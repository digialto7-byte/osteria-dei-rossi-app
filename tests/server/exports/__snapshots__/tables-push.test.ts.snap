// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`discards-vs-push > snapshots the header and writes one row per recipe; the totals are not a row 1`] = `
[
  "recipe_key",
  "preparazione",
  "durata_ore",
  "lotti_scartati",
  "lotti_in_evidenza",
  "porzioni_scartate",
  "porzioni_in_evidenza",
  "valore_eur",
  "senza_costo",
]
`;

exports[`forecast > snapshots the header 1`] = `
[
  "recipe_key",
  "preparazione",
  "data",
  "porzioni_attese",
  "porzioni_disponibili",
  "mancanti",
]
`;

