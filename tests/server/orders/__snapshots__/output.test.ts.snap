          "type": "string",
        },
        "openedBy": {
          "additionalProperties": false,
          "properties": {
            "displayName": {
              "type": "string",
            },
          },
          "required": [
            "displayName",
          ],
          "type": "object",
        },
        "openedToday": {
          "type": "boolean",
        },
        "status": {
          "enum": [
            "free",
            "open",
            "courses_sent",
            "bill_requested",
            "closed",
          ],
          "type": "string",
        },
        "tableId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "tableName": {
          "type": "string",
        },
      },
      "required": [
        "id",
        "tableId",
        "tableName",
        "covers",
        "status",
        "billRequested",
        "closed",
        "openedAt",
        "openedToday",
        "openedBy",
        "coperto",
      ],
      "type": "object",
    },
    "uscite": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "calledAt": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "lineCount": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
          },
          "state": {
            "enum": [
              "waiting",
              "cooking",
              "done",
            ],
            "type": "string",
          },
          "uscita": {
            "maximum": 9,
            "minimum": 1,
            "type": "integer",
          },
        },
        "required": [
          "uscita",
          "state",
          "calledAt",
          "lineCount",
        ],
        "type": "object",
      },
      "type": "array",
    },
  },
  "required": [
    "session",
    "lines",
    "uscite",
  ],
  "type": "object",
}
`;
