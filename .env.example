# Copy to .env and fill in real values locally. Never commit .env.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SECRET_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
# Must allow at least 36 000 output tokens (EXTRACTION_MAX_TOKENS).
EXTRACTION_MODEL_ID=replace-me
# Optional: low (default) | medium | high. Model reasoning effort; low is meant to keep invoice extraction within the 90 s timeout.
# EXTRACTION_EFFORT=low
GOOGLE_SERVICE_ACCOUNT_JSON=replace-me
RESEND_API_KEY=replace-me
SENTRY_DSN=replace-me
CRON_SECRET=replace-me
PIN_PEPPER=replace-me
# Only with variant V1 (Telegram alerts) or milestone M26
# TELEGRAM_BOT_TOKEN=replace-me
# TELEGRAM_WEBHOOK_SECRET=replace-me
# Backups (M25): the project's API URL (host <ref>.supabase.co), checked against the DB user
SUPABASE_URL=replace-me
# Publishable key of the same project, for the keep-alive ping
SUPABASE_PUBLISHABLE_KEY=replace-me
# The session-pooler URL of the project, user postgres.<project ref>
SUPABASE_DB_URL=replace-me
# At least 32 characters; the founder holds it
BACKUP_ENCRYPTION_PASSPHRASE=replace-me
# The Drive service account's JSON key and the Shared Drive folder id
BACKUP_DRIVE_SA_JSON=replace-me
BACKUP_DRIVE_FOLDER_ID=replace-me
# Staging/preview protection bypass for scripts/check-headers.ts; empty sends no header
VERCEL_AUTOMATION_BYPASS_SECRET=
# Reservations (ADR-032). Both keys need at least 32 characters. The gate key must equal Vault `reservation_gate_key`
# (supabase/seed.sql holds this same local fake); the link key signs cancel links and form tokens.
RESERVATION_GATE_KEY=replace-me-local-reservation-gate-key-0000
RESERVATION_LINK_KEY=replace-me-local-reservation-link-key-0000
# Kept only while rotating the link key, until older links have expired
# RESERVATION_LINK_KEY_PREVIOUS=replace-me
# resend | mailpit. mailpit is a dev and test sink and is refused in production; resend also needs RESEND_API_KEY
MAIL_TRANSPORT=mailpit
MAIL_FROM=prenotazioni@example.com
# The local Supabase mail catcher (Mailpit)
MAILPIT_URL=http://127.0.0.1:54324
# The app's public address: cancel links in e-mails are built on it (https in production)
APP_PUBLIC_ORIGIN=http://localhost:3000
