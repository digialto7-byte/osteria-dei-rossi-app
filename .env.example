# Copy to .env and fill in real values locally. Never commit .env.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SECRET_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
# Must allow at least 36 000 output tokens (EXTRACTION_MAX_TOKENS).
EXTRACTION_MODEL_ID=replace-me
GOOGLE_SERVICE_ACCOUNT_JSON=replace-me
RESEND_API_KEY=replace-me
SENTRY_DSN=replace-me
CRON_SECRET=replace-me
PIN_PEPPER=replace-me
# Only with variant V1 (Telegram alerts) or milestone M26
# TELEGRAM_BOT_TOKEN=replace-me
# TELEGRAM_WEBHOOK_SECRET=replace-me
# Backups (M25): the project's API URL (host <ref>.supabase.co), checked against the DB user
SUPABASE_URL=replace-me
# The session-pooler URL of the project, user postgres.<project ref>
SUPABASE_DB_URL=replace-me
# At least 32 characters; the founder holds it
BACKUP_ENCRYPTION_PASSPHRASE=replace-me
# The Drive service account's JSON key and the Shared Drive folder id
BACKUP_DRIVE_SA_JSON=replace-me
BACKUP_DRIVE_FOLDER_ID=replace-me
# Staging/preview protection bypass for scripts/check-headers.ts; empty sends no header
VERCEL_AUTOMATION_BYPASS_SECRET=
